APP_ENV=dev                     # prod disables /docs
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false             # true behind HTTPS
TRUST_PROXY=false               # true behind a reverse proxy (Hugging Face, Render)

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
HMAC_SECRET=

ADMIN_EMAIL=
# python scripts/hash_password.py  (keep the single quotes)
ADMIN_PASSWORD_HASH=''

MAX_USERS=10
MAX_CONVOS_PER_USER=10
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_IP=15
LOCKOUT_HOURS=3,12,24

WIKI_USER_AGENT=WikiRAGChatbot/1.0 (portfolio project; contact: you@example.com)

GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_MAIN_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GEMINI_MAIN_MODEL=gemini-3-flash-preview

GUEST_MESSAGE_LIMIT=10
USER_DAILY_TOKEN_BUDGET=40000
GLOBAL_DAILY_TOKEN_BUDGET=200000